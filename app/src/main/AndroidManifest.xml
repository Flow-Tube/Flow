<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fallback popup player for devices whose ROM does not expose native Android PiP. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <!-- Writing to a chosen folder through plain files on API 29 and below (legacy storage on 29) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Required for reading local video files on Android 13+ -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        android:minSdkVersion="33" />
    <!-- Required for reading local audio/music files on Android 13+ -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />
    <!-- Android 14+: lets the local library work when the viewer picks "Select photos and videos" -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Optional: allows saving downloads to public Movies/Music folders (survives app uninstall) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Required for DLNA/UPnP SSDP device discovery (FOSS casting, no Google services) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
        Request battery optimization exemption so Android Doze mode does not throttle
        network access or kill the background playback service.  The app will show a
        system dialog asking the user to approve the exemption; this is the same approach
        used by most open-source media players to survive aggressive OEM battery managers.
        (Referenced in-app via PowerManager.isIgnoringBatteryOptimizations check.)
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Microphone capture for music recognition (Shazam) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Device Sync (FLOW-SYNC/1): resolve the host LAN IP for the QR code. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Device Sync: scan the peer's QR code to receive the session key out-of-band. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Lets the equalizer page offer an installed system or third-party equalizer panel. -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <application
        android:name=".FlowApplication"
        android:allowBackup="true"
        android:backupAgent=".data.backup.FlowBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:fullBackupOnly="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_launcher_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flow"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="true">

        <!--
            Samsung keep-alive hints (same as NewPipe).
            Prevents Samsung’s DeX and screen-off battery manager from killing the
            background playback service on OneUI devices.
        -->
        <!-- Tells OEMs (Xiaomi HyperOS, Samsung OneUI) not to force letterboxing on large screens -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_MIN_ASPECT_RATIO_OVERRIDE"
            android:value="true" />
        <property
            android:name="android.window.PROPERTY_COMPAT_IGNORE_ORIENTATION_REQUEST_WHEN_LOOP_DETECTED"
            android:value="true" />

        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".TvActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Flow.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- singleTask: a share or link from another app must reach this instance through
             onNewIntent, not start a second one inside the sharing app's task (#1121). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Flow.Starting"
            android:windowSoftInputMode="adjustResize"
            android:windowLayoutInDisplayCutoutMode="shortEdges">

            <!-- Deep Links for YouTube URLs -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:host="m.music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/v" />
                <data android:pathPrefix="/live" />
                <data android:pathPrefix="/embed" />
                <data android:pathPrefix="/shorts" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/browse" />
                <data android:pathPrefix="/channel" />
                <data android:pathPrefix="/c" />
                <data android:pathPrefix="/user" />
                <data android:pathPrefix="/@" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="www.youtube-nocookie.com" />
                <data android:host="youtube-nocookie.com" />
                <data android:pathPrefix="/embed" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>

            <!-- Piped frontend links (same video IDs as YouTube) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="piped.video" />
                <data android:host="www.piped.video" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/shorts" />
            </intent-filter>

            <!-- Share Intent for text/plain -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- A playlist file shared from Flow opens here and is imported. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        
        <!-- Media3 Music Service -->
        <service
            android:name=".service.Media3MusicService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService"/>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        
        <!-- Video Playback Service (Media3 MediaSessionService) for background playback and media controls -->
        <service
            android:name=".service.VideoPlayerService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
            </intent-filter>
        </service>

        <!-- Media3 playback resumption: a headset's Play after Flow was killed reaches the music
             service (the only MediaLibraryService), which resumes the saved queue. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- The download queue runs as WorkManager work; its foreground service carries dataSync. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".data.video.downloader.work.DownloadActionReceiver"
            android:exported="false" />

        <!-- Device Sync (FLOW-SYNC/1) foreground service: keeps the LAN WebSocket
             transfer alive while the screen is off / app is backgrounded. -->
        <service
            android:name=".sync.transport.SyncForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync">
        </service>
        
        <!-- Notification action receiver for downloads and other actions -->
        <receiver 
            android:name=".notification.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.aedev.flow.action.CANCEL_DOWNLOAD" />
                <action android:name="io.github.aedev.flow.action.RETRY_DOWNLOAD" />
                <action android:name="io.github.aedev.flow.action.PAUSE_DOWNLOAD" />
                <action android:name="io.github.aedev.flow.action.RESUME_DOWNLOAD" />
                <action android:name="io.github.aedev.flow.action.DISMISS_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Restores a launcher entry after an update if the chosen icon alias no longer exists. -->
        <receiver
            android:name=".platform.LauncherAliasRepairReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Time Management Reminder Receiver -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Home-screen widgets (Jetpack Glance) -->
        <receiver
            android:name=".widget.core.action.WidgetPlaybackReceiver"
            android:exported="false" />
        <activity
            android:name=".widget.config.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Flow">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.nowplaying.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_now_playing_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>
        <receiver
            android:name=".widget.turntable.TurntableWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_turntable_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_turntable_info" />
        </receiver>
        <receiver
            android:name=".widget.quickactions.QuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_actions_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>
        <receiver
            android:name=".widget.recognize.RecognizeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recognize_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recognize_info" />
        </receiver>
        <receiver
            android:name=".widget.recent.RecentlyPlayedWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recently_played_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recently_played_info" />
        </receiver>
        <receiver
            android:name=".widget.onrepeat.OnRepeatWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_on_repeat_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_on_repeat_info" />
        </receiver>
        <receiver
            android:name=".widget.playlist.PlaylistWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_playlist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playlist_info" />
        </receiver>
        <receiver
            android:name=".widget.week.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <receiver
            android:name=".widget.downloads.DownloadsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_downloads_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_downloads_info" />
        </receiver>

        <!-- Download with Flow in the share menu: a shared link opens the download menu. -->
        <activity-alias
            android:name=".DownloadShareAlias"
            android:exported="true"
            android:label="@string/share_download_with_flow"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- App Icon Variants (via activity-alias)                          -->
        <!-- Default: Flow Red -->
        <activity-alias
            android:name=".IconFlowRed"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Flow Light -->
        <activity-alias
            android:name=".IconFlowLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_flow_light"
            android:roundIcon="@mipmap/ic_launcher_flow_light_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Flow Play (white background, red video frame + play mark) -->
        <activity-alias
            android:name=".IconFlowPlay"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_flow_play"
            android:roundIcon="@mipmap/ic_launcher_flow_play_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- AMOLED Dark -->
        <activity-alias
            android:name=".IconAmoled"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amoled"
            android:roundIcon="@mipmap/ic_launcher_amoled_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Monochrome (white background, dark F letter; Material You compatible) -->
        <activity-alias
            android:name=".IconMonochrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome"
            android:roundIcon="@mipmap/ic_launcher_monochrome_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Ghost / Outline (dark background, white squircle border + white F) -->
        <activity-alias
            android:name=".IconGhost"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ghost"
            android:roundIcon="@mipmap/ic_launcher_ghost_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic / Material You (neutral bg + monochrome layer; system tints on Android 13+) -->
        <activity-alias
            android:name=".IconDynamic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dynamic"
            android:roundIcon="@mipmap/ic_launcher_dynamic_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Material Sky -->
        <activity-alias
            android:name=".IconMaterialSky"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_material_sky"
            android:roundIcon="@mipmap/ic_launcher_material_sky_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Material Mint -->
        <activity-alias
            android:name=".IconMaterialMint"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_material_mint"
            android:roundIcon="@mipmap/ic_launcher_material_mint_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Scallop (Expressive) -->
        <activity-alias
            android:name=".IconExpressiveScallop"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expressive_scallop"
            android:roundIcon="@mipmap/ic_launcher_expressive_scallop_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Segmented F (Expressive) -->
        <activity-alias
            android:name=".IconExpressiveSegmented"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expressive_segmented"
            android:roundIcon="@mipmap/ic_launcher_expressive_segmented_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Sunny Play (Expressive) -->
        <activity-alias
            android:name=".IconExpressivePlay"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expressive_play"
            android:roundIcon="@mipmap/ic_launcher_expressive_play_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Sky Clover (Expressive) -->
        <activity-alias
            android:name=".IconExpressiveSky"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expressive_sky"
            android:roundIcon="@mipmap/ic_launcher_expressive_sky_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Mint Flower (Expressive) -->
        <activity-alias
            android:name=".IconExpressiveMint"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expressive_mint"
            android:roundIcon="@mipmap/ic_launcher_expressive_mint_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Night Cookie (Expressive) -->
        <activity-alias
            android:name=".IconExpressiveCookie"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expressive_cookie"
            android:roundIcon="@mipmap/ic_launcher_expressive_cookie_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Oval (Expressive) -->
        <activity-alias
            android:name=".IconExpressiveOval"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expressive_oval"
            android:roundIcon="@mipmap/ic_launcher_expressive_oval_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Pill (Expressive) -->
        <activity-alias
            android:name=".IconExpressivePill"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expressive_pill"
            android:roundIcon="@mipmap/ic_launcher_expressive_pill_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <!-- Files Flow hands to other apps: recap cards and playlist files, only from their cache folders. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_file_paths" />
        </provider>

        <!-- Song artwork for Android Auto, which only loads browse images from content URIs. Read access is granted to the browsing car app. -->
        <provider
            android:name=".service.auto.AutoArtworkProvider"
            android:authorities="${applicationId}.auto.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>

